# Telegram Bot Token (обязательно)
TELEGRAM_TOKEN=ваш_токен_сюда
# JWT Secret Key (обязательно, минимум 32 символа)
SECRET_KEY=my-super-secret-key-for-jwt-change-me-in-production

# Database URL
# Вариант 1: для Docker Compose (БД в контейнере)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/orders

# Вариант 2: для внешней БД (раскомментируйте и закомментите вариант 1)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname